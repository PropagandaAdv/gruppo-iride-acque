at", "typography_font_weight": "800", "typography_font_size": {"unit": "px", "size": 26}, "typography_line_height": {"unit": "em", "size": 1.25}, "typography_font_size_mobile": {"unit": "px", "size": 22}}, "elements": []}, {"id": "ebc1f930", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Con l'acquisizione di Bieffe Costruzioni, il Gruppo amplia il proprio perimetro operativo verso acquedotti, reti idriche e fognarie, impianti di depurazione e opere infrastrutturali per multiutility ed enti pubblici.</p>", "text_color": "#3D5A6C", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17.5}, "typography_line_height": {"unit": "em", "size": 1.7}}, "elements": []}, {"id": "3eee2886", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>L'integrazione rafforza la capacità del Gruppo di seguire il progetto dalla fase di ingegneria fino alla realizzazione, al revamping e alla manutenzione delle infrastrutture.</p>", "text_color": "#3D5A6C", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17.5}, "typography_line_height": {"unit": "em", "size": 1.7}}, "elements": []}, {"id": "fa27cd43", "elType": "container", "isInner": true, "settings": {"flex_direction": "row", "flex_direction_mobile": "column", "content_width": "full", "padding": {"unit": "px", "top": "6", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "4", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "bf663dd9", "elType": "widget", "widgetType": "button", "settings": {"text": "Leggi la news →", "link": {"url": "#", "is_external": "", "nofollow": ""}, "border_radius": {"unit": "px", "top": "999", "right": "999", "bottom": "999", "left": "999", "isLinked": true}, "typography_