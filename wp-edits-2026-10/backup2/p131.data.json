dget", "widgetType": "text-editor", "settings": {"editor": "<p>L'investimento sostiene il percorso di crescita industriale del Gruppo e accompagna l'acquisizione di Bieffe Costruzioni, ampliando ulteriormente le competenze e la capacità realizzativa nel settore delle infrastrutture idriche.</p>", "text_color": "#3D5A6C", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17.5}, "typography_line_height": {"unit": "em", "size": 1.7}}, "elements": []}, {"id": "2affd197", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>L'operazione rappresenta una nuova tappa nel percorso di sviluppo del Gruppo, già avviato con l'ingresso di Biemme Engineering.</p>", "text_color": "#3D5A6C", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17.5}, "typography_line_height": {"unit": "em", "size": 1.7}}, "elements": []}, {"id": "acffc6b4", "elType": "container", "isInner": true, "settings": {"flex_direction": "row", "flex_direction_mobile": "column", "content_width": "full", "padding": {"unit": "px", "top": "6", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "4", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "b6369eba", "elType": "widget", "widgetType": "button", "settings": {"text": "Leggi la news →", "link": {"url": "#", "is_external": "", "nofollow": ""}, "border_radius": {"unit": "px", "top": "999", "right": "999", "bottom": "999", "left": "999", "isLinked": true}, "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_weight": "700", "typography_font_size": {"unit": "px", "size": 16}, "text_padding": {"unit": "px", "top": "17", "right": "30", "bottom": "17", "left": "30", "isLinked": false}, "background_color": "rgba(0,0,0,0