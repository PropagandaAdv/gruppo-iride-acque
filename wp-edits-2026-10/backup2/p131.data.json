x", "size": 1.2}}, "elements": []}, {"id": "ccdd35e1", "elType": "widget", "widgetType": "heading", "settings": {"title": "EMER – Dropnet vince il PMI Award 2026", "header_size": "h3", "title_color": "#09171F", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_weight": "800", "typography_font_size": {"unit": "px", "size": 26}, "typography_line_height": {"unit": "em", "size": 1.25}, "typography_font_size_mobile": {"unit": "px", "size": 22}}, "elements": []}, {"id": "18271cfe", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Il progetto EMER – Dropnet di Iride Acque è stato premiato nell'ambito del PMI Award 2026, promosso dall'Osservatorio Innovazione Digitale nelle PMI della School of Management del Politecnico di Milano.</p>", "text_color": "#3D5A6C", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17.5}, "typography_line_height": {"unit": "em", "size": 1.7}}, "elements": []}, {"id": "9d3744f4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Il riconoscimento valorizza l'integrazione tra tecnologia di trattamento, economia circolare e digitalizzazione della gestione degli impianti attraverso un software proprietario di telecontrollo e telegestione da remoto.</p>", "text_color": "#3D5A6C", "typography_typography": "custom", "typography_font_family": "Montserrat", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17.5}, "typography_line_height": {"unit": "em", "size": 1.7}}, "elements": []}, {"id": "e1afcf7f", "elType": "container", "isInner": true, "settings": {"flex_direction": "row", "flex_direction_mobile": "column", "content_width": "full", "padding": {"unit": "px", "top": "6", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "4", "right": "0", "bottom": "0", "left": "0", "isLin