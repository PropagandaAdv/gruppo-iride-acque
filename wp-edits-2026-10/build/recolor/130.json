[{"id":"c000100","elType":"container","isInner":false,"settings":{"flex_direction":"column","flex_direction_mobile":"column","css_id":"sec-bhHeroMetodo","content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"w000099","elType":"widget","widgetType":"html","settings":{"html":"<style>\n.brand-hero{position:relative;overflow:hidden;background:#09171F;display:flex;flex-direction:column;min-height:100vh;}\n.brand-hero .bh-media{position:absolute;inset:0;width:100%;height:100%;}\n.brand-hero .bh-media img{width:100%;height:100%;object-fit:cover;object-position:right center;}\n.brand-hero .bh-scrim{position:absolute;inset:0;background:linear-gradient(100deg, rgba(9,23,31,.94) 0%, rgba(9,23,31,.86) 38%, rgba(9,23,31,.55) 65%, rgba(9,23,31,.35) 100%);pointer-events:none;}\n.brand-hero .bh-copy{position:relative;z-index:5;flex:1;display:flex;flex-direction:column;justify-content:center;padding:0 16px;box-sizing:border-box;}\n.brand-hero .bh-copy-inner{width:100%;max-width:1240px;margin:0 auto;}\n.brand-hero .hero-kicker{color:#8DD6E8;font-size:13px;letter-spacing:.22em;text-transform:uppercase;font-weight:600;margin-bottom:18px;font-family:'Montserrat',sans-serif;display:block;}\n.brand-hero .hero-h1{color:#fff;font-weight:800;letter-spacing:-.01em;line-height:1.08;font-size:clamp(2.2rem,5.2vw,4.4rem);max-width:900px;text-shadow:0 4px 30px rgba(0,0,0,.35);font-family:'Montserrat',sans-serif;margin:0;}\n.brand-hero .hero-h1 .accent{background:linear-gradient(90deg,#8DD6E8,#4AB7D5);-webkit-background-clip:text;background-clip:text;color:transparent;}\n.brand-hero .hero-ctas{display:flex;gap:16px;flex-wrap:wrap;margin-top:38px;}\n.brand-hero .btn-cta{display:inline-flex;align-items:center;gap:8px;padding:17px 30px;border-radius:999px;font-size:15px;font-weight:700;letter-spacing:.02em;background:#4AB7D5;color:#09171F;box-shadow:0 8px 24px rgba(74,183,213,.35);transition:transform .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s cubic-bezier(.22,.61,.36,1), background .35s cubic-bezier(.22,.61,.36,1);border:none;cursor:pointer;font-family:'Montserrat',sans-serif;text-decoration:none;}\n.brand-hero .btn-cta:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(74,183,213,.45);background:#8DD6E8;}\n.brand-hero .hero-subtitle{color:rgba(238,246,250,.86);font-size:20px;line-height:1.65;max-width:760px;margin:26px 0 0;font-family:'Montserrat',sans-serif;font-weight:300;}\n</style>\n<section class=\"brand-hero\" id=\"bhHeroMetodo\">\n  <div class=\"bh-media\"><img src=\"https://gruppoirideacque.propagandaadv.com/wp-content/uploads/2026/09/hero-template-bg.webp\" alt=\"\"></div>\n  <div class=\"bh-scrim\"></div>\n  <div class=\"bh-copy\">\n    <div class=\"bh-copy-inner\">\n      <span class=\"hero-kicker\">Modello operativo</span>\n      <h1 class=\"hero-h1\">Un processo strutturato in <span class=\"accent\">quattro fasi</span></h1>\n      <p class=\"hero-subtitle\">L'affidabilità di un impianto di trattamento acque dipende in misura determinante dal rigore con cui vengono gestite le fasi che precedono e seguono la sua realizzazione. Il Gruppo Iride Acque adotta un modello operativo articolato in quattro fasi, con continuità di responsabilità tecnica dall'analisi preliminare alla gestione O&amp;M.</p>\n    </div>\n  </div>\n</section>\n<script>\n(function(){\n  var hero = document.getElementById('bhHeroMetodo');\n  if(!hero) return;\n  function setH(){\n    var header = document.querySelector('header.elementor-location-header');\n    var hh = header ? header.getBoundingClientRect().height : 0;\n    hero.style.minHeight = 'calc(100vh - ' + hh + 'px)';\n  }\n  setH();\n  window.addEventListener('resize', setH);\n  window.addEventListener('load', setH);\n})();\n</script>\n"},"elements":[]}]},{"id":"c000106","elType":"container","isInner":false,"settings":{"flex_direction":"column","flex_direction_mobile":"column","css_id":"sec-metodo-fasi","content_width":"full","background_background":"classic","background_color":"#EEF6FA","padding":{"unit":"px","top":"100","right":"24","bottom":"110","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"70","right":"16","bottom":"70","left":"16","isLinked":false},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"_element_id":"metodo-fasi"},"elements":[{"id":"c000105","elType":"container","isInner":true,"settings":{"flex_direction":"column","flex_direction_mobile":"column","content_width":"boxed","boxed_width":{"unit":"px","size":1240},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0"},"flex_gap_mobile":{"unit":"px","size":0,"column":"0","row":"0"}},"elements":[{"id":"w000101","elType":"widget","widgetType":"tabs","settings":{"type":"horizontal","tabs":[{"_id":"mo00001","tab_title":"01  Analisi di processo","tab_content":"<p style=\"color:#1A4D6A;font-weight:800;font-size:14px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 10px;font-family:Montserrat,sans-serif;\">FASE 01</p><h3 style=\"color:#09171F;font-weight:800;font-size:30px;margin:0 0 14px;font-family:Montserrat,sans-serif;\">Analisi di processo e caratterizzazione reflui</h3><p style=\"color:#3D5A6C;font-size:18px;line-height:1.7;margin:0 0 20px;font-family:Montserrat,sans-serif;\">La fase preliminare comprende la caratterizzazione analitica dei reflui da trattare, la verifica del quadro autorizzativo applicabile (AUA, AIA) e dei limiti di scarico di riferimento (Tabella 3 e Tabella 4 del D.Lgs. 152/06 e successive modifiche), la valutazione degli spazi disponibili e l'analisi dei costi di gestione correnti (energia, reagenti, smaltimento fanghi).</p><ul style=\"margin:0;padding:0;list-style:none;display:grid;gap:14px;\"><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Sopralluoghi tecnici e campagne di campionamento</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Caratterizzazione analitica di laboratorio (COD, BOD, SST, metalli, composti specifici di processo)</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Studio di fattibilità tecnico-economica con valutazione CAPEX/OPEX</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Supporto nell'interlocuzione tecnica con gli enti di controllo</li></ul>"},{"_id":"mo00002","tab_title":"02  Progettazione e ingegneria","tab_content":"<p style=\"color:#1A4D6A;font-weight:800;font-size:14px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 10px;font-family:Montserrat,sans-serif;\">FASE 02</p><h3 style=\"color:#09171F;font-weight:800;font-size:30px;margin:0 0 14px;font-family:Montserrat,sans-serif;\">Progettazione di dettaglio e ingegnerizzazione</h3><p style=\"color:#3D5A6C;font-size:18px;line-height:1.7;margin:0 0 20px;font-family:Montserrat,sans-serif;\">La fase di ingegneria comprende il dimensionamento dei processi di trattamento, la selezione tecnologica (trattamenti chimico-fisici, filtrazione a membrana MBR/UF/RO, sistemi ZLD ove richiesto), il layout impiantistico e la progettazione dell'automazione e della strumentazione di controllo, con attenzione fin dalla fase progettuale ai fabbisogni di manutenzione e all'efficienza energetica dell'impianto.</p><ul style=\"margin:0;padding:0;list-style:none;display:grid;gap:14px;\"><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Progettazione di processo, meccanica ed elettrostrumentale</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Selezione tecnologica basata su efficienza di abbattimento, consumi energetici specifici e ingombri</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Supporto nell'iter di permitting e nelle procedure autorizzative ambientali</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Modellazione e simulazione di processo in fase pre-costruttiva</li></ul>"},{"_id":"mo00003","tab_title":"03  Construction &amp; Commissioning","tab_content":"<p style=\"color:#1A4D6A;font-weight:800;font-size:14px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 10px;font-family:Montserrat,sans-serif;\">FASE 03</p><h3 style=\"color:#09171F;font-weight:800;font-size:30px;margin:0 0 14px;font-family:Montserrat,sans-serif;\">Construction &amp; Commissioning</h3><p style=\"color:#3D5A6C;font-size:18px;line-height:1.7;margin:0 0 20px;font-family:Montserrat,sans-serif;\">La fase realizzativa comprende la costruzione, la fornitura e l'installazione impiantistica, con supervisione tecnica diretta da parte del Gruppo. La fase di commissioning prevede il collaudo funzionale, la taratura dei parametri di processo e la verifica delle prestazioni rispetto ai valori di progetto, propedeutica alla consegna operativa dell'impianto.</p><ul style=\"margin:0;padding:0;list-style:none;display:grid;gap:14px;\"><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Costruzione e montaggio impiantistico chiavi in mano</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Collaudi funzionali e messa a punto dei set-point di processo</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Formazione tecnica del personale del cliente</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Documentazione tecnica, manualistica e as-built completi</li></ul>"},{"_id":"mo00004","tab_title":"04  Operation &amp; Maintenance","tab_content":"<p style=\"color:#1A4D6A;font-weight:800;font-size:14px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 10px;font-family:Montserrat,sans-serif;\">FASE 04</p><h3 style=\"color:#09171F;font-weight:800;font-size:30px;margin:0 0 14px;font-family:Montserrat,sans-serif;\">Operation &amp; Maintenance (O&amp;M) con telecontrollo H24</h3><p style=\"color:#3D5A6C;font-size:18px;line-height:1.7;margin:0 0 20px;font-family:Montserrat,sans-serif;\">La fase di gestione operativa continuativa costituisce l'elemento determinante per l'affidabilità di processo nel medio-lungo periodo. Il servizio di O&amp;M include il presidio tecnico quotidiano dell'impianto, la manutenzione preventiva e correttiva, e il telecontrollo H24 attraverso le sale di supervisione del Gruppo, con l'obiettivo di intercettare tempestivamente eventuali scostamenti di processo prima che determinino fermo impianto o superamento dei limiti allo scarico.</p><ul style=\"margin:0;padding:0;list-style:none;display:grid;gap:14px;\"><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Manutenzione ordinaria, straordinaria e programmata, supportata da modelli predittivi</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Telecontrollo H24 con reportistica periodica dei parametri di processo</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Gestione di reagenti, materiali di consumo e ricambistica</li><li style=\"position:relative;padding-left:34px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.15em;width:22px;height:22px;border-radius:50%;background:#4AB7D5;color:#09171F;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;\">&#10003;</span>Reperibilità tecnica e pronto intervento sul territorio</li></ul>"}],"tab_color":"#09171F","tab_active_color":"#FFFFFF","background_color":"transparent","border_width":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"tab_typography_typography":"custom","tab_typography_font_family":"Montserrat","tab_typography_font_weight":"700","tab_typography_font_size":{"unit":"px","size":17},"content_color":"#3D5A6C","content_typography_typography":"custom","content_typography_font_family":"Montserrat","content_typography_font_weight":"400","content_typography_font_size":{"unit":"px","size":17.5},"custom_css":"selector .elementor-tabs-wrapper { display:flex!important; flex-wrap:wrap; gap:12px; margin-bottom:22px; }\nselector .elementor-tab-desktop-title { padding: 18px 26px !important; border-radius: 999px !important; background:#FFFFFF !important; border:0!important; box-shadow:0 10px 30px -18px rgba(9,23,31,.35); transition: background .3s ease, color .3s ease; }\nselector .elementor-tab-desktop-title:hover { background:#DDEFF6 !important; }\nselector .elementor-tab-desktop-title.elementor-active { background:#09171F !important; }\nselector .elementor-tab-title .iah-tabnum { color:#4AB7D5; font-weight:800; margin-right:6px; }\nselector .elementor-tab-desktop-title::before, selector .elementor-tab-desktop-title::after { display:none!important; }\nselector .elementor-tabs-content-wrapper { background:#FFFFFF !important; border-radius:28px !important; padding:56px !important; border:0!important; box-shadow:0 30px 70px -30px rgba(9,23,31,.3); }\nselector .elementor-tab-content { border:0!important; }\nselector .elementor-tab-mobile-title { color:#09171F!important; background:#EEF6FA!important; border-radius:14px; margin-bottom:8px; border:0!important; }\nselector .elementor-tab-mobile-title.elementor-active { background:#4AB7D5!important; }\n@media(max-width:767px){ selector .elementor-tabs-content-wrapper{ padding:24px !important; } }"},"elements":[]},{"id":"w000102","elType":"widget","widgetType":"html","settings":{"html":"<script>\n(function(){\n  function go(scroll){\n    var m=(location.hash||'').match(/fase-([1-4])/); if(!m) return;\n    var w=document.getElementById('metodo-fasi'); if(!w) return;\n    var sel='[data-tab=\"'+m[1]+'\"]';\n    var t=w.querySelector('.elementor-tab-desktop-title'+sel), tm=w.querySelector('.elementor-tab-mobile-title'+sel);\n    var target=(window.innerWidth>767?t:tm)||t;\n    if(target && !target.classList.contains('elementor-active')) target.click();\n    if(scroll) setTimeout(function(){ window.scrollTo({top: w.getBoundingClientRect().top + window.pageYOffset - 70, behavior:'smooth'}); },150);\n  }\n  window.addEventListener('load',function(){ setTimeout(function(){go(true);},350); });\n  window.addEventListener('hashchange',function(){go(true);});\n})();\n</script>","_css_classes":"iah-global"},"elements":[]},{"id":"c000104","elType":"container","isInner":true,"settings":{"flex_direction":"row","flex_direction_mobile":"column","content_width":"full","flex_justify_content":"center","padding":{"unit":"px","top":"48","right":"0","bottom":"0","left":"0","isLinked":false},"padding_mobile":{"unit":"px","top":"30","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"w000103","elType":"widget","widgetType":"button","settings":{"text":"Richiedi un'analisi tecnica preliminare del tuo impianto →","link":{"url":"#contatti","is_external":"","nofollow":""},"border_radius":{"unit":"px","top":"999","right":"999","bottom":"999","left":"999","isLinked":true},"typography_typography":"custom","typography_font_family":"Montserrat","typography_font_weight":"700","typography_font_size":{"unit":"px","size":17.5},"text_padding":{"unit":"px","top":"17","right":"30","bottom":"17","left":"30","isLinked":false},"background_color":"#4AB7D5","button_text_color":"#09171F","button_background_hover_color":"#8DD6E8","hover_color":"#09171F"},"elements":[]}]}]}]}]