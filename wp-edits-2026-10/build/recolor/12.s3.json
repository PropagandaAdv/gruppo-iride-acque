ount=\"120\" style=\"display:block;text-align:center;font-family:Montserrat,sans-serif;font-size:64px;font-weight:700;color:#8DD6E8;line-height:1;\">120</span>\n<script>\n(function(){\n  function parseNum(str){\n    var clean = String(str).replace(/\\./g,'').replace(/,/g,'.').trim();\n    var n = parseFloat(clean);\n    return isNaN(n) ? null : n;\n  }\n  function formatIt(n){ return Math.round(n).toLocaleString('it-IT'); }\n  function animate(el, target){\n    var duration = 1600, start = null;\n    function step(ts){\n      if(!start) start = ts;\n      var p = Math.min((ts-start)/duration, 1);\n      var eased = 1 - Math.pow(1-p, 3);\n      el.textContent = formatIt(target*eased);\n      if(p<1) requestAnimationFrame(step); else el.textContent = formatIt(target);\n    }\n    requestAnimationFrame(step);\n  }\n  function init(){\n    var els = document.querySelectorAll('.iah-counter[data-finalcount]');\n    if(!els.length) return;\n    if(!('IntersectionObserver' in window)){ return; }\n    var io = new IntersectionObserver(function(entries){\n      entries.forEach(function(entry){\n        if(!entry.isIntersecting) return;\n        var el = entry.target;\n        if(el.dataset.animated) return;\n        var target = parseNum(el.dataset.finalcount);\n        if(target === null) return;\n        el.dataset.animated = '1';\n        animate(el, target);\n      });\n    }, {threshold:0.4});\n    els.forEach(function(el){ io.observe(el); });\n  }\n  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }\n})();\n</script>\n"},"elements":[],"widgetType":"html"},{"id":"n000034","elType":"container","settings":{"content_width":"full","flex_direction":"row","flex_direction_mobile":"row","background_background":"classic","background_color":"#8DD6E8","border_radius":{"unit":"px","top":"999","right":"999","bottom":"999","left":"999","isLinked":true},"padding":{"unit":"px","top":"3","right":"9","bottom":"3","left":"9","isL