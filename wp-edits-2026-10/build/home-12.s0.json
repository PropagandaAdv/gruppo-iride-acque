nimation:iahFadeUp .9s cubic-bezier(.22,.61,.36,1) .36s forwards;}\r\n@keyframes iahFadeUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}\r\n.iah-hero .btn-cta{display:inline-flex;align-items:center;gap:8px;padding:17px 30px;border-radius:999px;font-size:15px;font-weight:700;letter-spacing:.02em;background:#4AB7D5;color:#0D2B3E;box-shadow:0 8px 24px rgba(74,183,213,.35);transition:transform .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s cubic-bezier(.22,.61,.36,1), background .35s cubic-bezier(.22,.61,.36,1);border:none;cursor:pointer;font-family:'Montserrat',sans-serif;text-decoration:none;}\r\n.iah-hero .btn-cta:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(74,183,213,.45);background:#8DD6E8;}\r\n.iah-hero .scroll-cue{position:absolute;right:16px;bottom:34px;z-index:6;color:#EEF6FA;font-size:11px;letter-spacing:.18em;text-transform:uppercase;opacity:.7;display:flex;flex-direction:column;align-items:center;gap:8px;font-family:'Montserrat',sans-serif;}\r\n.iah-hero .scroll-cue .line{width:1px;height:34px;background:linear-gradient(180deg,#8DD6E8,transparent);animation:iahCueFlow 1.8s cubic-bezier(.22,.61,.36,1) infinite;}\r\n@keyframes iahCueFlow{0%{opacity:.2;}50%{opacity:1;}100%{opacity:.2;}}\r\n@media (prefers-reduced-motion:reduce){\r\n  .iah-hero .hero-media video{display:none;}\r\n  .iah-hero .hero-kicker,.iah-hero .hero-h1,.iah-hero .hero-ctas{animation:none;opacity:1;transform:none;}\r\n  .iah-hero .scroll-cue .line{animation:none;opacity:.6;}\r\n}\r\n@media (max-width:720px){\r\n  .iah-hero{min-height:80vh;}\r\n  .iah-hero .hero-copy{min-height:80vh;}\r\n}\r\n</style>\r\n<section class=\"iah-hero\" id=\"iahHero\">\r\n  <div class=\"hero-media\" id=\"iahHeroMedia\">\r\n    <video id=\"iahHeroVideo\" autoplay muted loop playsinline preload=\"auto\" src=\"https://gruppoirideacque.propagandaadv.com/wp-content/uploads/2026/09/istockphoto-2201795152-640_adpp_is.mp4\" aria-hidden=\"true\"></video>\r\n  </div>\r\n  <div class=\"hero-scrim\"></div>\r\n  <div class=\"hero-copy\">\r\n    <div class=\"hero-copy-inner\">\r\n      <span class=\"hero-kicker\">Gruppo Iride Acque</span>\r\n      <h1 class=\"hero-h1\">Soluzioni integrate per il trattamento e la <span class=\"accent\">gestione delle acque</span> civili e industriali</h1>\n    </div>\r\n  </div>\r\n  <div class=\"scroll-cue\" aria-hidden=\"true\"><div class=\"line\"></div></div>\r\n</section>\r\n<script>\r\n(function(){\r\n  'use strict';\r\n  var video = document.getElementById('iahHeroVideo');\r\n\r\n  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){\r\n    video.removeAttribute('autoplay');\r\n    video.pause();\r\n  }\r\n\r\n  function scrollToElementId(elId){\r\n    var el = document.querySelector('.elementor-element-' + elId);\r\n    if(el){ el.scrollIntoView({behavior:'smooth', block:'start'}); }\r\n  }\r\n  document.querySelectorAll('.iah-hero [data-scroll-target]').forEach(function(a){\r\n    a.addEventListener('click', function(e){\r\n      e.preventDefault();\r\n      scrollToElementId(a.getAttribute('data-scroll-target'));\r\n    });\r\n  });\r\n})();\r\n</script>"},"elements":[],"widgetType":"html"}],"isInner":false}]