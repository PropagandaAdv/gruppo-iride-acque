[{"id":"r000070","elType":"container","isInner":false,"settings":{"css_id":"sec-ilgruppo-2","_element_id":"metodo-operativo","content_width":"full","flex_direction":"column","flex_direction_mobile":"column","background_background":"classic","background_color":"#0D2B3E","padding":{"unit":"px","top":"110","right":"24","bottom":"110","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"70","right":"16","bottom":"70","left":"16","isLinked":false},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"r000071","elType":"container","isInner":true,"settings":{"content_width":"boxed","flex_direction":"column","flex_direction_mobile":"column","boxed_width":{"unit":"px","size":1240},"flex_gap":{"unit":"px","size":16,"column":"16","row":"16"}},"elements":[{"id":"r000072","elType":"widget","widgetType":"text-editor","elements":[],"settings":{"editor":"<p>Il nostro metodo</p>","text_color":"#8DD6E8","typography_typography":"custom","typography_font_family":"Montserrat","typography_font_weight":"800","typography_font_size":{"unit":"px","size":19.5},"typography_letter_spacing":{"unit":"px","size":1.4}}},{"id":"r000073","elType":"widget","widgetType":"heading","elements":[],"settings":{"title":"Un processo strutturato in quattro fasi","header_size":"h2","title_color":"#FFFFFF","typography_typography":"custom","typography_font_family":"Montserrat","typography_font_weight":"800","typography_font_size":{"unit":"px","size":43.0},"typography_font_size_mobile":{"unit":"px","size":26.5},"typography_line_height":{"unit":"em","size":1.2}}},{"id":"r000074","elType":"widget","widgetType":"text-editor","elements":[],"settings":{"editor":"<p>L'affidabilità di un impianto di trattamento acque dipende in misura determinante dal rigore con cui vengono gestite le fasi che precedono e seguono la sua realizzazione. Il Gruppo Iride Acque adotta un modello operativo articolato in quattro fasi, con continuità di responsabilità tecnica dall'analisi preliminare alla gestione O&amp;M.</p>","text_color":"rgba(238,246,250,.82)","typography_typography":"custom","typography_font_family":"Montserrat","typography_font_weight":"300","typography_font_size":{"unit":"px","size":19.0},"typography_line_height":{"unit":"em","size":1.7},"_max_width":{"unit":"px","size":860}}}]},{"id":"r000075","elType":"container","isInner":true,"settings":{"content_width":"boxed","flex_direction":"column","flex_direction_mobile":"column","boxed_width":{"unit":"px","size":1240},"padding":{"unit":"px","top":"64","right":"0","bottom":"0","left":"0","isLinked":false},"padding_mobile":{"unit":"px","top":"36","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"r000076","elType":"widget","widgetType":"tabs","elements":[],"settings":{"type":"vertical","navigation_width":{"unit":"%","size":30},"tabs":[{"_id":"ph00004","tab_title":"01  Analisi di processo e caratterizzazione reflui","tab_content":"<p style=\"color:#4AB7D5;font-weight:700;font-size:14px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 10px;font-family:Montserrat,sans-serif;\">FASE 01</p><h3 style=\"color:#0D2B3E;font-weight:800;font-size:30px;margin:0 0 14px;font-family:Montserrat,sans-serif;\">Analisi di processo e caratterizzazione reflui</h3><p style=\"color:#3D5A6C;font-size:18px;line-height:1.7;margin:0 0 20px;font-family:Montserrat,sans-serif;\">La fase preliminare comprende la caratterizzazione analitica dei reflui da trattare, la verifica del quadro autorizzativo applicabile (AUA, AIA) e dei limiti di scarico di riferimento (Tabella 3 e Tabella 4 del D.Lgs. 152/06 e successive modifiche), la valutazione degli spazi disponibili e l'analisi dei costi di gestione correnti (energia, reagenti, smaltimento fanghi).</p><ul style=\"margin:0;padding:0;list-style:none;display:grid;gap:12px;\"><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Sopralluoghi tecnici e campagne di campionamento</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Caratterizzazione analitica di laboratorio (COD, BOD, SST, metalli, composti specifici di processo)</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Studio di fattibilità tecnico-economica con valutazione CAPEX/OPEX</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Supporto nell'interlocuzione tecnica con gli enti di controllo</li></ul>"},{"_id":"ph00004","tab_title":"02  Progettazione di dettaglio e ingegnerizzazione","tab_content":"<p style=\"color:#4AB7D5;font-weight:700;font-size:14px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 10px;font-family:Montserrat,sans-serif;\">FASE 02</p><h3 style=\"color:#0D2B3E;font-weight:800;font-size:30px;margin:0 0 14px;font-family:Montserrat,sans-serif;\">Progettazione di dettaglio e ingegnerizzazione</h3><p style=\"color:#3D5A6C;font-size:18px;line-height:1.7;margin:0 0 20px;font-family:Montserrat,sans-serif;\">La fase di ingegneria comprende il dimensionamento dei processi di trattamento, la selezione tecnologica (trattamenti chimico-fisici, filtrazione a membrana MBR/UF/RO, sistemi ZLD ove richiesto), il layout impiantistico e la progettazione dell'automazione e della strumentazione di controllo, con attenzione fin dalla fase progettuale ai fabbisogni di manutenzione e all'efficienza energetica dell'impianto.</p><ul style=\"margin:0;padding:0;list-style:none;display:grid;gap:12px;\"><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Progettazione di processo, meccanica ed elettrostrumentale</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Selezione tecnologica basata su efficienza di abbattimento, consumi energetici specifici e ingombri</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Supporto nell'iter di permitting e nelle procedure autorizzative ambientali</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Modellazione e simulazione di processo in fase pre-costruttiva</li></ul>"},{"_id":"ph00004","tab_title":"03  Construction &amp; Commissioning","tab_content":"<p style=\"color:#4AB7D5;font-weight:700;font-size:14px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 10px;font-family:Montserrat,sans-serif;\">FASE 03</p><h3 style=\"color:#0D2B3E;font-weight:800;font-size:30px;margin:0 0 14px;font-family:Montserrat,sans-serif;\">Construction &amp; Commissioning</h3><p style=\"color:#3D5A6C;font-size:18px;line-height:1.7;margin:0 0 20px;font-family:Montserrat,sans-serif;\">La fase realizzativa comprende la costruzione, la fornitura e l'installazione impiantistica, con supervisione tecnica diretta da parte del Gruppo. La fase di commissioning prevede il collaudo funzionale, la taratura dei parametri di processo e la verifica delle prestazioni rispetto ai valori di progetto, propedeutica alla consegna operativa dell'impianto.</p><ul style=\"margin:0;padding:0;list-style:none;display:grid;gap:12px;\"><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Costruzione e montaggio impiantistico chiavi in mano</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Collaudi funzionali e messa a punto dei set-point di processo</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Formazione tecnica del personale del cliente</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Documentazione tecnica, manualistica e as-built completi</li></ul>"},{"_id":"ph00004","tab_title":"04  Operation &amp; Maintenance (O&amp;M) con telecontrollo H24","tab_content":"<p style=\"color:#4AB7D5;font-weight:700;font-size:14px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 10px;font-family:Montserrat,sans-serif;\">FASE 04</p><h3 style=\"color:#0D2B3E;font-weight:800;font-size:30px;margin:0 0 14px;font-family:Montserrat,sans-serif;\">Operation &amp; Maintenance (O&amp;M) con telecontrollo H24</h3><p style=\"color:#3D5A6C;font-size:18px;line-height:1.7;margin:0 0 20px;font-family:Montserrat,sans-serif;\">La fase di gestione operativa continuativa costituisce l'elemento determinante per l'affidabilità di processo nel medio-lungo periodo. Il servizio di O&amp;M include il presidio tecnico quotidiano dell'impianto, la manutenzione preventiva e correttiva, e il telecontrollo H24 attraverso le sale di supervisione del Gruppo, con l'obiettivo di intercettare tempestivamente eventuali scostamenti di processo prima che determinino fermo impianto o superamento dei limiti allo scarico.</p><ul style=\"margin:0;padding:0;list-style:none;display:grid;gap:12px;\"><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Manutenzione ordinaria, straordinaria e programmata, supportata da modelli predittivi</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Telecontrollo H24 con reportistica periodica dei parametri di processo</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Gestione di reagenti, materiali di consumo e ricambistica</li><li style=\"position:relative;padding-left:26px;font-size:17.5px;line-height:1.5;color:#3D5A6C;font-weight:400;font-family:Montserrat,sans-serif;\"><span style=\"position:absolute;left:0;top:.5em;width:8px;height:8px;border-radius:2px;background:linear-gradient(135deg,#4AB7D5,#1A4D6A);\"></span>Reperibilità tecnica e pronto intervento sul territorio</li></ul>"}],"tab_color":"rgba(238,246,250,.78)","tab_active_color":"#0D2B3E","background_color":"transparent","border_width":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"tab_typography_typography":"custom","tab_typography_font_family":"Montserrat","tab_typography_font_weight":"700","tab_typography_font_size":{"unit":"px","size":18.5},"content_color":"#3D5A6C","content_typography_typography":"custom","content_typography_font_family":"Montserrat","content_typography_font_size":{"unit":"px","size":17.5},"custom_css":"selector .elementor-tab-title { padding: 22px 24px !important; border-radius: 16px !important; margin-bottom: 10px !important; background: rgba(255,255,255,.06) !important; border:0!important; transition: background .3s ease; }\nselector .elementor-tab-desktop-title:hover { background: rgba(255,255,255,.12) !important; }\nselector .elementor-tab-title.elementor-active { background: #4AB7D5 !important; }\nselector .elementor-tabs-content-wrapper { background: #FFFFFF !important; border-radius: 24px !important; padding: 48px !important; border:0!important; }\nselector .elementor-tab-content { border:0!important; }\nselector .elementor-tab-mobile-t