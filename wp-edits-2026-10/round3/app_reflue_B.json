[{"id":"1b1887e","elType":"container","isInner":false,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","background_background":"classic","background_color":"#09171F","css_classes":"iah-sec ap-sec","_element_id":"vantaggi"},"elements":[{"id":"1aaa910","elType":"container","isInner":true,"settings":{"content_width":"boxed","flex_direction":"column","flex_direction_mobile":"column","boxed_width":{"unit":"px","size":1240},"flex_gap":{"unit":"px","size":22,"column":"22","row":"22"}},"elements":[{"id":"8b82334","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Perché scegliere il Gruppo Iride</p>","_css_classes":"iah-eyebrow iah-eyebrow-d"},"elements":[]},{"id":"491c465","elType":"widget","widgetType":"heading","settings":{"title":"I vantaggi delle nostre soluzioni","header_size":"h2","_css_classes":"ap-h2"},"elements":[]},{"id":"7966e04","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Progettiamo impianti di depurazione su misura, combinando competenze ingegneristiche e tecnologie di trattamento per ottimizzare le prestazioni, ridurre l'impatto ambientale e favorire il recupero delle risorse.</p>","_css_classes":"ap-lead"},"elements":[]},{"id":"30305d9","elType":"container","isInner":true,"settings":{"content_width":"boxed","flex_direction":"column","flex_direction_mobile":"column","boxed_width":{"unit":"px","size":1240},"css_classes":"ap-grid ap-g2"},"elements":[{"id":"62b4340","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-card"},"elements":[{"id":"bf20ba2","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>01</p>","_css_classes":"ap-n"},"elements":[]},{"id":"3ea95a5","elType":"widget","widgetType":"heading","settings":{"title":"Efficacia depurativa","header_size":"h3"},"elements":[]},{"id":"c84dc46","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Soluzioni progettate per garantire la rimozione degli inquinanti e il raggiungimento dei requisiti qualitativi richiesti, nel rispetto dei limiti di scarico e delle esigenze di processo.</p>","_css_classes":"ap-t"},"elements":[]}]},{"id":"36d00df","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-card"},"elements":[{"id":"90163ab","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>02</p>","_css_classes":"ap-n"},"elements":[]},{"id":"c07656a","elType":"widget","widgetType":"heading","settings":{"title":"Efficienza operativa","header_size":"h3"},"elements":[]},{"id":"5c83231","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>I nostri impianti ottimizzano consumi, prestazioni e continuità di esercizio, contribuendo alla riduzione dei costi di gestione e manutenzione.</p>","_css_classes":"ap-t"},"elements":[]}]},{"id":"31e5f97","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-card"},"elements":[{"id":"95a64e2","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>03</p>","_css_classes":"ap-n"},"elements":[]},{"id":"c211b62","elType":"widget","widgetType":"heading","settings":{"title":"Impianti completamente automatizzati","header_size":"h3"},"elements":[]},{"id":"8c229a1","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Sistemi di controllo e automazione evoluti consentono una gestione affidabile, continua e semplificata dell'impianto, con monitoraggio costante dei processi e rapido intervento operativo.</p>","_css_classes":"ap-t"},"elements":[]}]},{"id":"ffde9f9","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-card"},"elements":[{"id":"f3c4e64","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>04</p>","_css_classes":"ap-n"},"elements":[]},{"id":"460814a","elType":"widget","widgetType":"heading","settings":{"title":"Sostenibilità e recupero delle risorse","header_size":"h3"},"elements":[]},{"id":"eec7292","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Le nostre soluzioni favoriscono il recupero dell'acqua e, ove possibile, delle materie prime, contribuendo a modelli produttivi più efficienti, sostenibili e orientati all'economia circolare.</p>","_css_classes":"ap-t"},"elements":[]}]}]}]}]},{"id":"baaba77","elType":"container","isInner":false,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","background_background":"classic","background_color":"#09171F","css_classes":"iah-sec ap-sec","_element_id":"settori"},"elements":[{"id":"4ef4448","elType":"container","isInner":true,"settings":{"content_width":"boxed","flex_direction":"column","flex_direction_mobile":"column","boxed_width":{"unit":"px","size":1240},"flex_gap":{"unit":"px","size":22,"column":"22","row":"22"}},"elements":[{"id":"f232878","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Dove operiamo</p>","_css_classes":"iah-eyebrow iah-eyebrow-d"},"elements":[]},{"id":"abdda66","elType":"widget","widgetType":"heading","settings":{"title":"Settori di applicazione","header_size":"h2","_css_classes":"ap-h2"},"elements":[]},{"id":"f123c8c","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Le soluzioni del Gruppo Iride per il trattamento delle acque reflue trovano applicazione in contesti industriali, civili e infrastrutturali, con impianti progettati in funzione delle caratteristiche degli scarichi, degli obiettivi di depurazione e dei requisiti normativi.</p><p>Grazie a un approccio su misura e all'integrazione di diverse tecnologie, sviluppiamo sistemi affidabili ed efficienti per la gestione degli scarichi, la riduzione dell'impatto ambientale e, ove possibile, il recupero delle risorse.</p>","_css_classes":"ap-lead"},"elements":[]},{"id":"749006e","elType":"container","isInner":true,"settings":{"content_width":"boxed","flex_direction":"column","flex_direction_mobile":"column","boxed_width":{"unit":"px","size":1240},"css_classes":"ap-grid ap-g2"},"elements":[{"id":"4ed444c","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-card"},"elements":[{"id":"d637b6e","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>01</p>","_css_classes":"ap-n"},"elements":[]},{"id":"3a35927","elType":"widget","widgetType":"heading","settings":{"title":"Industria e processi produttivi","header_size":"h3"},"elements":[]},{"id":"258213f","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Progettiamo impianti per il trattamento delle acque reflue provenienti da attività industriali e processi produttivi, con soluzioni personalizzate per settori come alimentare e bevande, chimica, farmaceutica e cosmetica, tessile, cartaria, metalmeccanica, galvanica, manifatturiera ed energetica.</p>","_css_classes":"ap-t"},"elements":[]}]},{"id":"9f12e0f","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-card"},"elements":[{"id":"587dac7","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>02</p>","_css_classes":"ap-n"},"elements":[]},{"id":"851af59","elType":"widget","widgetType":"heading","settings":{"title":"Settore civile, commerciale e infrastrutture","header_size":"h3"},"elements":[]},{"id":"d029bf4","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Realizziamo soluzioni per il trattamento delle acque reflue generate da edifici, strutture ricettive, attività commerciali e infrastrutture pubbliche, anche in contesti con esigenze impiantistiche specifiche, come complessi residenziali, hotel e strutture Ho.Re.Ca., campeggi, strutture sanitarie e sportive, scuole, edifici pubblici e comunità.</p>","_css_classes":"ap-t"},"elements":[]}]}]}]}]},{"id":"bed8afc","elType":"container","isInner":false,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","background_background":"classic","background_color":"#FFFFFF","css_classes":"iah-sec ap-sec","_element_id":"case-study"},"elements":[{"id":"a7acad1","elType":"container","isInner":true,"settings":{"content_width":"boxed","flex_direction":"column","flex_direction_mobile":"column","boxed_width":{"unit":"px","size":1240},"flex_gap":{"unit":"px","size":22,"column":"22","row":"22"}},"elements":[{"id":"c157408","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Le nostre realizzazioni</p>","_css_classes":"iah-eyebrow"},"elements":[]},{"id":"6892d0b","elType":"widget","widgetType":"heading","settings":{"title":"Case study","header_size":"h2","_css_classes":"ap-h2 ap-h2-d"},"elements":[]},{"id":"6238ed0","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Gruppo Iride sviluppa soluzioni personalizzate per il trattamento delle acque reflue, con un'attenzione concreta al recupero, al riutilizzo e all'efficienza dei processi di depurazione.</p>","_css_classes":"ap-intro"},"elements":[]},{"id":"c9c7f64","elType":"container","isInner":true,"settings":{"content_width":"boxed","flex_direction":"column","flex_direction_mobile":"column","boxed_width":{"unit":"px","size":1240},"css_classes":"ap-grid ap-g2"},"elements":[{"id":"4d45977","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-card ap-case"},"elements":[{"id":"b9db7ec","elType":"widget","widgetType":"image","settings":{"image":{"url":"https://gruppoirideacque.propagandaadv.com/wp-content/uploads/2026/10/case-study-tintoria-emiliana-recupero-sali-v2.webp","id":404,"alt":"Moduli di ultrafiltrazione ceramica dell'impianto di recupero dei sali di tintura"},"image_size":"full","_css_classes":"ap-ci"},"elements":[]},{"id":"6a0c3cd","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Settore tessile</p>","_css_classes":"ap-tag"},"elements":[]},{"id":"f61cb02","elType":"widget","widgetType":"heading","settings":{"title":"Tintoria Emiliana","header_size":"h3"},"elements":[]},{"id":"2484a71","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Recupero dei sali e trattamento integrato delle acque reflue</p>","_css_classes":"ap-sub"},"elements":[]},{"id":"bf20c10","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Impianto progettato per il recupero dei sali di tintura mediante ultrafiltrazione ceramica e nanofiltrazione. I concentrati delle membrane vengono trattati con tecnologia EMER, mentre l'effluente trattato e il resto dei reflui di stabilimento confluiscono in un impianto biologico prima dello scarico in fognatura.</p><p>È inoltre previsto un upgrade con osmosi inversa per il recupero delle acque in uscita dal biologico.</p>","_css_classes":"ap-t"},"elements":[]},{"id":"b5de74a","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>UF ceramica • NF • EMER • biologico • upgrade RO</p>","_css_classes":"ap-pills"},"elements":[]}]},{"id":"611af30","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-card ap-case"},"elements":[{"id":"c9cf9c5","elType":"widget","widgetType":"image","settings":{"image":{"url":"https://gruppoirideacque.propagandaadv.com/wp-content/uploads/2026/10/case-study-eni-sarroch-lavaggio-v4.webp","id":407,"alt":"Serbatoi blu e filtri a sabbia dell'impianto di trattamento delle acque di lavaggio"},"image_size":"full","_css_classes":"ap-ci"},"elements":[]},{"id":"bde8d4e","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Settore energetico</p>","_css_classes":"ap-tag"},"elements":[]},{"id":"744ee31","elType":"widget","widgetType":"heading","settings":{"title":"ENI | Sarroch","header_size":"h3"},"elements":[]},{"id":"100f95e","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Trattamento e riutilizzo delle acque di lavaggio</p>","_css_classes":"ap-sub"},"elements":[]},{"id":"cc56488","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Impianto realizzato per il trattamento delle acque reflue provenienti dal lavaggio delle bombole di gas. Il sistema integra un reattore EMER per l'ossidazione delle acque, seguito da filtrazione a sabbia e carbone attivo per l'affinamento finale e il riutilizzo dell'acqua nel processo produttivo.</p>","_css_classes":"ap-t"},"elements":[]},{"id":"b2fd96c","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>EMER • filtro a sabbia • carbone attivo • riutilizzo</p>","_css_classes":"ap-pills"},"elements":[]}]},{"id":"db12e8e","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column","flex_direction_mobile":"column","css_classes":"ap-soon ap-wide"},"elements":[{"id":"ff9c082","elType":"widget","widgetType":"icon","settings":{"selected_icon":{"value":"far fa-images","library":"fa-regular"},"primary_color":"#8AA4B4","size":{"unit":"px","size":54},"align":"center"},"elements":[]},{"id":"6a11606","elType":"widget","widgetType":"heading","settings":{"title":"Prossimi progetti","header_size":"h3","align":"center"},"elements":[]},{"id":"930444b","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Nuove realizzazioni saranno presto disponibili.</p>","_css_classes":"ap-t ap-center"},"elements":[]}]}]}]}]}]